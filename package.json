{
  "name": "specbridge-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "An open, model-agnostic spec runtime for existing Kiro projects.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "qualification:vnext-10-2:fast": "vitest run tests/qualification/production-qualification.test.ts tests/qualification/offline-qualification.test.ts tests/autonomy/zero-touch-certification.test.ts tests/autonomy/completion-gate.test.ts",
    "qualification:vnext-10-2:fault-replay": "vitest run tests/autonomy/supervisor.test.ts tests/orchestration/subscription-cooldown.test.ts tests/orchestration/objectives-resume-parallel.test.ts tests/drift/evidence-and-state.test.ts tests/orchestration/objectives-aggregation-e2e.test.ts tests/autonomy/completion-gate.test.ts tests/autonomy/closure-lifecycle.test.ts tests/autonomy/closure-oracle.test.ts tests/autonomy/mission-qualification.test.ts tests/research/deerflow.test.ts tests/orchestration/quota-driver.test.ts",
    "qualification:vnext-10-2:secondary": "vitest run tests/orchestration/secondary-objective-builder.test.ts tests/orchestration/builder-routing.test.ts tests/orchestration/subscription-cooldown.test.ts",
    "qualification:vnext-10-2:research": "vitest run tests/research/research-layer.test.ts tests/research/research-lifecycle.test.ts tests/research/deerflow.test.ts",
    "qualification:vnext-10-2:cooldown": "vitest run tests/orchestration/subscription-cooldown.test.ts",
    "qualification:vnext-10-2:soak": "vitest run tests/qualification/soak.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "generate:builtin-templates": "node scripts/generate-builtin-templates.mjs",
    "check:builtin-templates": "node scripts/generate-builtin-templates.mjs --check",
    "generate:template-gallery": "node scripts/generate-template-gallery.mjs",
    "check:template-gallery": "node scripts/generate-template-gallery.mjs --check",
    "build:plugin": "pnpm build && pnpm --filter specbridge-claude-plugin build && node scripts/build-codex-plugin.mjs",
    "build:codex-plugin": "node scripts/build-codex-plugin.mjs",
    "check:codex-plugin": "node scripts/build-codex-plugin.mjs --check",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "validate:codex-plugin": "node scripts/validate-codex-plugin.mjs",
    "verify:plugin-bundle": "node scripts/verify-plugin-bundle.mjs",
    "verify:codex-plugin-bundle": "node scripts/verify-codex-plugin-bundle.mjs",
    "validate:extension-registry": "node scripts/validate-extension-registry.mjs",
    "generate:extension-registry": "node scripts/generate-extension-registry.mjs",
    "check:extension-registry": "node scripts/generate-extension-registry.mjs --check",
    "generate:builtin-registry": "node scripts/generate-builtin-registry.mjs",
    "check:builtin-registry": "node scripts/generate-builtin-registry.mjs --check",
    "generate:extension-gallery": "node scripts/generate-extension-gallery.mjs",
    "check:extension-gallery": "node scripts/generate-extension-gallery.mjs --check",
    "generate:public-contracts": "node scripts/check-public-contracts.mjs",
    "check:public-contracts": "node scripts/check-public-contracts.mjs --check",
    "generate:mcp-docs": "node scripts/generate-mcp-docs.mjs",
    "check:mcp-docs": "node scripts/generate-mcp-docs.mjs --check",
    "check:security": "node scripts/security-scan.mjs",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node packages/mcp-server/dist/standalone.js --stdio"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.14.0",
    "vitest": "^3.0.0"
  }
}
