{
  "name": "@specbridge/intake",
  "version": "1.1.0",
  "description": "Zero-touch spec intake for SpecBridge: full-specification ingestion, repository-grounded discovery, delta authority analysis, one human approval, provenance-aware derived approval, and the atomic seal-and-build lifecycle.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@specbridge/autonomy": "workspace:*",
    "@specbridge/compat-kiro": "workspace:*",
    "@specbridge/core": "workspace:*",
    "@specbridge/mission": "workspace:*",
    "@specbridge/orchestration": "workspace:*",
    "@specbridge/workflow": "workspace:*",
    "zod": "^3.23.8",
    "@specbridge/context": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
